# ==============================================================================
# CloudDrive Backend Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# SQLite (Local Dev): sqlite:///./drive.db
# PostgreSQL (Production / Vercel / Neon / Postgres): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./drive.db

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JWT tokens (Replace in production)
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production

# Access token expiration time in minutes (default: 30)
ACCESS_TOKEN_MINUTES=30

# Refresh token expiration time in days (default: 14)
REFRESH_TOKEN_DAYS=14

# ------------------------------------------------------------------------------
# Frontend & CORS
# ------------------------------------------------------------------------------
# Origin URL of the frontend application allowed for CORS credentials
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Vercel Blob Object Storage (Production Persistent Storage)
# ------------------------------------------------------------------------------
# Primary read/write token for Vercel Blob Object Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Vercel Blob Store ID
BLOB_STORE_ID=store_xxxxxxxxxxxx

# Optional Vercel Blob Webhook Public Key
BLOB_WEBHOOK_PUBLIC_KEY=blob_webhook_pubkey_xxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Storage Fallback & Limits
# ------------------------------------------------------------------------------
# Local directory used for storage fallback when running offline without Blob token
STORAGE_DIR=./storage

# Maximum allowed file upload size in megabytes
MAX_UPLOAD_MB=100
